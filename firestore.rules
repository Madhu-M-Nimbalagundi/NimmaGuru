rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if owns(userId);
      allow delete: if false;

      match /profile/{profileId} {
        allow read, create, update: if owns(userId);
        allow delete: if false;
      }

      match /assignments/{assignmentId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId);
        allow delete: if false;
      }

      match /progress/{progressId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId);
        allow delete: if false;
      }
    }

    match /guruProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if owns(userId);
      allow delete: if false;
    }

    match /classSessions/{sessionId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /classrooms/{classroomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerGuruId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerGuruId == request.auth.uid;
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.ownerGuruId == request.auth.uid;
        allow update: if signedIn() && resource.data.ownerGuruId == request.auth.uid;
        allow delete: if false;
      }
    }

    match /materials/{materialId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /curriculum/{curriculumId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /appreciations/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
