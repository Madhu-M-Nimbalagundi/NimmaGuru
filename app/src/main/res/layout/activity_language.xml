<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_app" android:orientation="vertical" android:padding="@dimen/screen_padding">
    <TextView android:id="@+id/backButton" style="@style/TextAppearance.NimmaGuru.Title" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="@string/back_arrow" android:textColor="@color/brand_green" />
    <TextView style="@style/TextAppearance.NimmaGuru.Headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/language" android:textColor="@color/brand_green" android:textStyle="bold" />
    <TextView style="@style/TextAppearance.NimmaGuru.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/language_change_hint" />
    <com.google.android.material.button.MaterialButton android:id="@+id/englishButton" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="24dp" android:text="@string/english" />
    <com.google.android.material.button.MaterialButton android:id="@+id/kannadaButton" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="12dp" android:text="@string/kannada_language" />
    <com.google.android.material.button.MaterialButton android:id="@+id/hindiButton" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="12dp" android:text="@string/hindi_language" />
</LinearLayout>

