<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:id="@+id/avatarTextView"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_profile_avatar"
        android:gravity="center"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nameTextView"
        style="@style/TextAppearance.NimmaGuru.Headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/roleTextView"
        style="@style/TextAppearance.NimmaGuru.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/badgeTextView"
        style="@style/TextAppearance.NimmaGuru.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primaryButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="28dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/secondaryButton"
        style="@style/Widget.NimmaGuru.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settingsButton"
        style="@style/Widget.NimmaGuru.TextButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="12dp"
        android:text="@string/settings" />

    <TextView
        android:id="@+id/assignedTasksTitleTextView"
        style="@style/TextAppearance.NimmaGuru.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignedTasksTextView"
        style="@style/TextAppearance.NimmaGuru.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:padding="18dp"
        android:text="@string/no_tasks_found"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
