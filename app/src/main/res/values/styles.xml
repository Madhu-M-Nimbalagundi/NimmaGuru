<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NimmaGuru" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.NimmaGuru.Button</item>
        <item name="chipStyle">@style/Widget.NimmaGuru.Chip.Filter</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="TextAppearance.NimmaGuru.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.NimmaGuru.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.NimmaGuru.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.NimmaGuru.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.NimmaGuru.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_button</item>
    </style>

    <style name="Widget.NimmaGuru.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.NimmaGuru.Button</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.NimmaGuru.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.NimmaGuru.Button</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.NimmaGuru.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.NimmaGuru.Button</item>
    </style>

    <style name="Widget.NimmaGuru.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="Widget.NimmaGuru.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/chip_min_height</item>
        <item name="android:textAppearance">@style/TextAppearance.NimmaGuru.Secondary</item>
    </style>
</resources>
